# Copy this file to .env and set your DeepSeek API key.
# The key is read locally and is never rendered in the app or written to logs.
DEEPSEEK_API_KEY=在这里填写你自己的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional: your contact email for Crossref's polite pool.
# CROSSREF_MAILTO=you@example.edu
